# Copy to .env.local. See supabase/README.md.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key only — never the secret / service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# Optional: a throwaway test account for `pnpm check:browser`. Never a real one.
BUDGET_TEST_EMAIL=
BUDGET_TEST_PASSWORD=
